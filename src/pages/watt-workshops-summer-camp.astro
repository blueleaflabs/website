---
import '../styles/watt.css';
import Base from '../layouts/Base.astro';
import Testimonials from '../components/Testimonials.astro';
import { getCollection } from 'astro:content';
const mailto = 'mailto:rohan.agarwal@blueleaflabs.org?subject=' + encodeURIComponent('Watt Workshops - online course');
// Testimonials for the completed camp. Quotes are verbatim from the post-camp feedback form.
const testimonials = [
  {
    name: 'Mr. G',
    role: 'Math Olympiads teacher, City of Cupertino',
    rating: 5,
    quotes: [
      { prompt: 'One thing you liked about Watt Workshops', text: 'Extremely well organized. You did your research well. The slides were seamless and easy to follow.' },
      { prompt: 'One new thing you learned during Watt Workshops', text: '(Not what you were intending, but) I learned that even shy students can do a pretty decent job with public presentations in spite of no public speaking experience. All 5 scored 6 or higher, which is pretty impressive.' },
    ],
  },
];
const wwPosts = (await getCollection('posts'))
  .filter((p) => p.data.published && p.data.series === 'watt-workshops-summer-camp')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (x) => x.toISOString().slice(0, 10);
---
<Base title="Watt Workshops Summer Camp | Blue Leaf Labs" description="Watt Workshops Summer Camp is a hands-on environmental engineering camp for grades 7 to 10: five days from first principles to a project you research, design, and present.">
  <div class="wrap ww">
    <section class="ww-hero">
      <span class="ww-eyebrow">Watt Workshops Summer Camp · Environmental engineering camp</span>
      <h1>Climate change isn't just a cause. It's an engineering problem.</h1>
      <p class="ww-lede">Students already know the power of protests, petitions, and policy. Watt Workshops Summer Camp adds the missing half: the science and engineering behind real climate solutions. Over five days, they'll learn how engineers produce the fresh water we drink every day, mitigate the effects of our overheating planet, and clean our grid to reduce fossil fuel pollution. Finally, they'll put what they've learned to the test by designing a solution to a real-life environmental engineering problem.</p>
      <div class="ww-cta-row">
        <span class="status complete">Complete</span>
        <span class="ww-next">Ran July 13 to 17, 2026</span>
        <a class="ww-btn" href="/watt-workshops">See Watt Workshops 2026-2027</a>
      </div>
      <div class="ww-tags">
        <span class="ww-tag">Build · Test · Improve</span>
        <span class="ww-tag">Real engineering tools</span>
        <span class="ww-tag">Solve a real climate problem</span>
        <span class="ww-tag">Present your own solution</span>
      </div>
    </section>

    <div class="ww-glance">
      <div class="ww-gi"><div class="k">Who</div><div class="v">Grades 7-10</div></div>
      <div class="ww-gi"><div class="k">When</div><div class="v">5 days · 2 hrs/day</div></div>
      <div class="ww-gi"><div class="k">Group</div><div class="v">Capped at 8 students</div></div>
      <div class="ww-gi"><div class="k">Bring</div><div class="v">Laptop + pen</div></div>
    </div>

    <section class="ww-sec">
      <h2>The week at Watt</h2>
      <p class="ww-secsub">Five days from theory to application to beyond.</p>
      <div class="ww-week">
        <div class="ww-day"><div class="ww-num"><span class="dow">Mon</span><span class="dn">1</span></div><div><div class="dt">What is environmental engineering?</div><div class="dd">Figure out how and why climate solutions are built and the problems they solve. Then, dive into a debate about the merits of fossil fuels.</div></div></div>
        <div class="ww-day"><div class="ww-num"><span class="dow">Tue</span><span class="dn">2</span></div><div><div class="dt">Water, heat, and your voice</div><div class="dd">Explore how we move, clean, and cool, the core of water and heat engineering. In the afternoon, sharpen your public-speaking and policy skills so your ideas actually land.</div></div></div>
        <div class="ww-day"><div class="ww-num"><span class="dow">Wed</span><span class="dn">3</span></div><div><div class="dt">Clean energy solutions</div><div class="dd">Investigate solar, wind, hydro, geothermal, and biofuel through real case studies from around the globe. Then draw your Scenario Challenge and start your investigation.</div></div></div>
        <div class="ww-day"><div class="ww-num"><span class="dow">Thu</span><span class="dn">4</span></div><div><div class="dt">Research and build</div><div class="dd">A fast crash course in how to research like a pro, then a full work session to dig into your scenario and design your solution poster.</div></div></div>
        <div class="ww-day"><div class="ww-num"><span class="dow">Fri</span><span class="dn">5</span></div><div><div class="dt">Present and celebrate</div><div class="dd">Present your Scenario Solution poster to the group, then close out by exploring next steps such as science fairs, peer-reviewed publications, and real scientific conferences.</div></div></div>
      </div>
    </section>

    <section class="ww-sec">
      <h2>What you'll walk away with</h2>
      <div class="ww-outcomes">
        <div class="ww-oc"><div class="ot">A solution poster you present</div><div class="od">A real, portfolio-worthy project you research, design, and defend in front of the group.</div></div>
        <div class="ww-oc"><div class="ot">Hands-on engineering skills</div><div class="od">Work with real environmental tools and the Define-Measure-Build-Test-Improve design loop.</div></div>
        <div class="ww-oc"><div class="ot">Confidence speaking up</div><div class="od">Practice public speaking and persuasion so you can pitch ideas and advocate clearly.</div></div>
        <div class="ww-oc"><div class="ot">A launchpad for science fairs</div><div class="od">Leave with a project and the know-how to carry it into competitions and beyond.</div></div>
      </div>
    </section>

    <Testimonials heading="What teachers said" sub="Feedback from the July 2026 camp, in the reviewer's own words." items={testimonials} />

    {wwPosts.length > 0 && (
      <section class="ww-sec">
        <h2>Field notes</h2>
        <p class="ww-secsub">Dispatches from the workshops: what students built, and what we learned running them.</p>
        <div class="ww-notes">
          {wwPosts.map((p) => (
            <a class="ww-note" href={`/notes/${p.id}`}>
              <span class="ww-note-date">{fmt(p.data.date)}</span>
              <span class="ww-note-title">{p.data.title}</span>
              <span class="ww-note-sum">{p.data.summary}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="ww-band">
      <h2>The Summer Camp is complete. Watt Workshops continues.</h2>
      <p>Watt Workshops now runs through the 2026-2027 school year as single-afternoon sessions on local water, energy, and waste.</p>
      <a class="ww-btn" href="/watt-workshops">See Watt Workshops 2026-2027</a>
      <div class="ww-online">A self-paced online course is on the way as the video lectures are built. <a href={mailto}>Email us</a> to be notified when it opens.</div>
    </section>
  </div>
</Base>
