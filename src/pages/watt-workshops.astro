---
import '../styles/watt.css';
import Base from '../layouts/Base.astro';
import WattSession from '../components/WattSession.astro';
import WattWhyJoin from '../components/WattWhyJoin.astro';
import WattRow from '../components/WattRow.astro';
import { getCollection } from 'astro:content';
import { wattSessions, nextWattSession, wattDate, wattStatus } from '../data/site';
// Everything about individual workshops comes from wattSessions in src/data/site.ts.
// Featured: the next upcoming session, or the latest one once all have passed.
const upcoming = nextWattSession();
const w = upcoming ?? wattSessions[wattSessions.length - 1];
const lead = upcoming ? 'Next workshop' : 'Most recent workshop';
// History: every session in the series, newest first.
const all = [...wattSessions].sort((a, b) => b.date.localeCompare(a.date));
const wwPosts = (await getCollection('posts'))
  .filter((p) => p.data.published && p.data.series === 'watt-workshops')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (x) => x.toISOString().slice(0, 10);
---
<Base title="Watt Workshops 2026-2027 | Blue Leaf Labs" description={`Learn about local water, wattage, and waste issues at Watt Workshops. ${lead}: ${w.title}, ${wattDate(w.date)} at ${w.venue}.`}>
  <div class="wf">
    <div class="wf-hero">
      <div class="wrap">
        <div class="wf-hero-top">
          <span class="wf-label">Blue Leaf Labs presents</span>
          <span class="wf-pill">Watt Workshops · 2026-2027</span>
        </div>
        <h1>Learn about local water, wattage, and waste issues at Watt Workshops.</h1>
        <p class="wf-lede">Middle school students already know how conservation efforts work. At Watt Workshops, they'll learn how environmental issues and climate change affect them on a daily basis in Santa Clara Valley. They'll learn where their water and energy come from, understand the ways our area disposes of waste, and brainstorm solutions to the most pressing problems we face here in the Valley.</p>
        <div class="wf-rule" aria-hidden="true"></div>
      </div>
    </div>

    <WattSession session={w} lead={lead} linkTitle>
      <WattWhyJoin />
      <Fragment slot="after">
        <div class="wf-sec">
          <span class="wf-label">2026-2027 series</span>
          <h2 class="wf-h2">All workshops</h2>
          <div class="ledger wf-ledger">
            {all.map((x) => (
              <WattRow program={{ name: wattDate(x.date, "short"), href: `/watt-workshops/${x.slug}`, status: wattStatus(x), summary: `#${x.number} · ${x.title}. ${x.subtitle}.` }} />
            ))}
          </div>
        </div>

        {wwPosts.length > 0 && (
          <div class="ww-sec wf-sec">
            <h2>Field notes</h2>
            <p class="ww-secsub">Dispatches from the workshops: what students built, and what we learned running them.</p>
            <div class="ww-notes">
              {wwPosts.map((p) => (
                <a class="ww-note" href={`/notes/${p.id}`}>
                  <span class="ww-note-date">{fmt(p.data.date)}</span>
                  <span class="ww-note-title">{p.data.title}</span>
                  <span class="ww-note-sum">{p.data.summary}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {upcoming && (
          <div class="wf-close">
            <div>
              <h2>Next workshop: {wattDate(w.date, 'short')} · {w.topic}</h2>
              <p>{wattDate(w.date)}, {w.time} at {w.venue}. Grades {w.grades}.</p>
            </div>
            <a class="wf-btn amber" href="/watt-workshops/register">Sign up</a>
          </div>
        )}
        <p class="wf-past">Watt Workshops began as a five-day camp in July 2026. <a href="/watt-workshops-summer-camp">See the Watt Workshops Summer Camp →</a></p>
      </Fragment>
    </WattSession>
  </div>
</Base>
